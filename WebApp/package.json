{
  "name": "sportsphere",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && rm -rf .next/standalone/public && ln -sfn ../../public .next/standalone/public || true",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "build:pwa": "next build",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=../prisma/schema.prisma",
    "db:seed": "npx tsx ../prisma/seed.ts",
    "db:studio": "prisma studio --schema=../prisma/schema.prisma",
    "db:push": "prisma db push --schema=../prisma/schema.prisma",
    "db:setup": "prisma generate --schema=../prisma/schema.prisma && prisma db push --schema=../prisma/schema.prisma && npx tsx ../prisma/seed.ts",
    "postinstall": "prisma generate --schema=../prisma/schema.prisma",
    "start:dev": "next start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.536.0",
    "@google-cloud/storage": "^6.11.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^8.3.0",
    "expo-server-sdk": "^7.1.0",
    "framer-motion": "^11.11.0",
    "input-otp": "^1.2.4",
    "jose": "^6.2.7",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.454.0",
    "next": "^16.2.12",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.1",
    "react-resizable-panels": "^2.1.4",
    "recharts": "^2.12.7",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "tw-animate-css": "^1.2.5",
    "vaul": "^0.9.9",
    "zod": "^3.23.8",
    "zustand": "^5.0.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "pg": "^8.22.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx ../prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
