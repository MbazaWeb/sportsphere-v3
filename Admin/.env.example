# ─── SportSphere Admin — environment ──────────────────────────
# Copy to .env and fill in. All values are required in production.

# Base URL of the main fan web app (the one on port 3002).
# The admin app calls this app's /api/admin/* routes as its backend.
MAIN_APP_URL=http://104.152.50.173:3002/sportsphere

# Port the admin app listens on. Must match the port in `npm start`.
# Default is 3003 (set in package.json).
PORT=3003

# Secret used to wrap the admin session cookie. Should be a long random
# string. Generate with: openssl rand -hex 32
# NOTE: this is NOT the same as the main app's SESSION_SECRET — the admin
# app stores the main app's ss_session JWT inside its own encrypted cookie.
ADMIN_COOKIE_SECRET=replace-me-with-openssl-rand-hex-32

# Public URL of THIS admin app (used for self-referencing redirects).
NEXT_PUBLIC_ADMIN_URL=http://104.152.50.173:3003

# Optional: name shown in the sidebar.
NEXT_PUBLIC_ADMIN_NAME=SportSphere Admin
