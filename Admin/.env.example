# ─── SportSphere Admin — environment ──────────────────────────
# Copy to .env and fill in. All values are required in production.

# PostgreSQL connection string — SAME database as the fan web app.
# The admin app reads and writes directly to this DB via Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sportsphere

# Port the admin app listens on. Default 3003 (set in package.json).
PORT=3003

# Secret used to sign the admin_session JWT cookie. Must be >=32 chars.
# Generate with: openssl rand -hex 32
# This is SEPARATE from the fan app's SESSION_SECRET — defense in depth.
ADMIN_JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Public URL of THIS admin app (used for cookie Secure flag + self-links).
NEXT_PUBLIC_ADMIN_URL=http://104.152.50.173:3003

# Public URL of the fan web app (for the "Open SportSphere app" sidebar link).
NEXT_PUBLIC_MAIN_APP_URL=http://104.152.50.173:3002/sportsphere

# Optional: name shown in the sidebar.
NEXT_PUBLIC_ADMIN_NAME=SportSphere Admin
