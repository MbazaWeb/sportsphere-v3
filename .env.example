# ═══════════════════════════════════════════════════════════════════════════════
# SportSphere v3 — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
#
# Generate secrets:   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development                         # development | production

# ─── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000    # https://sportsphere.app in prod
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/sportsphere          # must match next.config.ts basePath

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sportsphere

# ─── Session / JWT ───────────────────────────────────────────────────────────
# REQUIRED in production — app crashes on startup if missing.
# Generate: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# ─── Email — Resend ──────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# FROM_EMAIL=SportSphere <noreply@sportsphere.app>   # after domain verification

# ─── File Uploads — Cloudinary ───────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── File Uploads — AWS S3 ───────────────────────────────────────────────────
# https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── File Uploads — Google Cloud Storage (optional, alternative to S3) ───────
GCS_BUCKET=

# ─── Sports Data — API-Football ──────────────────────────────────────────────
# https://www.api-football.com/dashboard  (optional — disables live scores if blank)
API_FOOTBALL_KEY=
