# ─── SportSphere environment variables ────────────────────────
# Copy this file to `.env` (local dev) or set these in your hosting
# provider's dashboard (production). NEVER commit the real `.env`.

# Database — SQLite for local dev. For production switch to Postgres
# (e.g. postgresql://user:pass@host:5432/sportsphere) and change the
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Session secret — used to sign JWT session cookies. MUST be a long
# random string in production (>= 32 chars). Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-please-set-SESSION_SECRET-in-env-9f2a4c1b"

# Public app URL — used to build absolute URLs (e.g. password reset
# links sent via email). For local dev this is http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY=re_your_api_key_here

# ─── Supabase (required in production) ──────────────────────────
# Get these from https://supabase.com/dashboard → your project →
# Project Settings → API.
#
# NEXT_PUBLIC_* are baked into the Next.js standalone BUILD, so you
# MUST rebuild the WebApp after changing them. SUPABASE_SERVICE_ROLE_KEY
# is server-side only — never expose it to the browser.
#
# The Prisma-shaped adapter at WebApp/src/lib/db.ts talks to
# supabaseAdmin (which uses SUPABASE_SERVICE_ROLE_KEY) for ALL DB
# queries, so if these are missing, every query falls back to the
# placeholder 'https://invalid.supabase.co' and fails silently.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service-role-key-keep-server-side-only"

# ─── Socket.IO (real-time server) ──────────────────────────────
# The 'sportsphere-ws' PM2 process runs scripts/ws-server.mjs. It
# loads .env from process.cwd() (see ws-server.mjs) — so these must
# be set in the ROOT .env at /var/www/sportsphere-nextjs/.env.
#
# WS_AUTH_SECRET: shared secret that browser clients must present in
#   the `register_user` payload to authenticate. MUST be >= 32 chars.
#   Generate with: openssl rand -hex 32
#   NEVER expose this to the browser via NEXT_PUBLIC_*.
WS_AUTH_SECRET=""
WS_PORT=3004
WS_INTERNAL_PORT=3005
WS_ALLOWED_ORIGINS="https://sportssphere.fun,https://www.sportssphere.fun,https://sportsphere.app,https://www.sportsphere.app,http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002"

# ─── Socket.IO client (WebApp — baked at build time) ───────────
# If NEXT_PUBLIC_SOCKET_URL is empty, the client uses same-origin
# (https://sportssphere.fun in production). The path is always
# '/socket.io' (matches nginx /socket.io/ → upstream 127.0.0.1:3004).
NEXT_PUBLIC_SOCKET_URL=""
NEXT_PUBLIC_SOCKET_ENABLED="true"
NEXT_PUBLIC_SOCKET_RECONNECT_ATTEMPTS=5
NEXT_PUBLIC_SOCKET_RECONNECT_DELAY=1000
NEXT_PUBLIC_SOCKET_RECONNECT_DELAY_MAX=15000
NEXT_PUBLIC_SOCKET_TIMEOUT=20000

# Public client registration token (OPTIONAL). If non-empty, the
# browser will send it in the `register_user` payload so the server
# can authenticate the client. Use a SEPARATE low-privilege token —
# NOT the server-side WS_AUTH_SECRET above.
NEXT_PUBLIC_WS_AUTH_SECRET=""
