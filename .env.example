# ─── SportSphere environment variables ────────────────────────
# Copy this file to `.env` (local dev) or set these in your hosting
# provider's dashboard (production). NEVER commit the real `.env`.

# Database — SQLite for local dev. For production switch to Postgres
# (e.g. postgresql://user:pass@host:5432/sportsphere) and change the
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Session secret — used to sign JWT session cookies. MUST be a long
# random string in production (>= 32 chars). Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-please-set-SESSION_SECRET-in-env-9f2a4c1b"

# Public app URL — used to build absolute URLs (e.g. password reset
# links sent via email). For local dev this is http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY=re_your_api_key_here
