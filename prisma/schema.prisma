// SportSphere — Prisma Schema
// Database: SQLite (local development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ─────────────────────────────────────────────────────
model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  handle              String   @unique
  passwordHash        String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  avatarUrl           String?
  coverUrl            String?
  avatarInitials      String?
  role                String   @default("fan")
  verificationStatus  String   @default("none")
  isVerified          Boolean  @default(false)
  bio                 String?
  aboutMe             String?
  pronouns            String?
  location            String?
  coverGradient       String   @default("from-emerald-600 to-emerald-900")
  followerCount       Int      @default(0)
  followingCount      Int      @default(0)
  postCount           Int      @default(0)
  roleData            String   @default("{}")
  sportsFollowing     String   @default("[]")
  registeredAt        DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastSeenAt          DateTime @default(now())

  // ─── Personal ──────────────────────────────────────────────
  dateOfBirth         DateTime?
  gender              String?
  nationality         String?
  countryOfOrigin     String?
  currentCountry      String?
  region              String?
  city                String?
  preferredLanguage   String?
  timezone            String?

  // ─── Contact ───────────────────────────────────────────────
  phone               String?
  website             String?
  whatsapp            String?
  socialInstagram     String?
  socialX             String?
  socialTikTok        String?
  socialFacebook      String?
  socialLinkedIn      String?
  socialYouTube       String?
  socialThreads       String?

  // ─── Appearance (stored inline for simplicity) ────────────
  theme               String   @default("dark")
  fontSize            String   @default("medium")
  reducedMotion       Boolean  @default(false)
  highContrast        Boolean  @default(false)

  // ─── Privacy (stored as JSON for flexibility) ─────────────
  privacySettings     String   @default("{}")

  // ─── Notification preferences (stored as JSON) ────────────
  notifPrefs          String   @default("{}")

  // ─── Interests (stored as JSON array) ─────────────────────
  interests           String   @default("[]")

  // ─── Role-specific extended data (stored as JSON) ─────────
  roleProfile         String   @default("{}")

  // Relations
  posts               Post[]
  comments            Comment[]
  likes               PostLike[]
  sentFollows         Follow[]           @relation("Follower")
  receivedFollows     Follow[]           @relation("Following")
  notifications       Notification[]     @relation("NotificationUser")
  actorNotifications  Notification[]     @relation("NotificationActor")
  sentMessages        Message[]          @relation("MessageSender")
  receivedMessages    Message[]          @relation("MessageReceiver")
  predictions         Prediction[]
  verificationReqs    VerificationRequest[]
  communityMemberships CommunityMember[]
  createdCommunities  Community[]
  favorites           UserFavorite[]

  @@index([handle])
  @@index([email])
  @@index([role])
  @@index([resetToken])
  @@index([countryOfOrigin])
  @@index([currentCountry])
}

// ─── User Favorites (teams, players, coaches, stadiums, leagues, national teams) ──
model UserFavorite {
  id          String   @id @default(uuid())
  userId      String
  targetType  String   // 'team' | 'player' | 'coach' | 'stadium' | 'league' | 'national_team' | 'competition'
  targetName  String   // display name (e.g. "Manchester United")
  targetHandle String? // @handle if the target is a user on the platform
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetName])
  @@index([userId, targetType])
}

// ─── Follows ───────────────────────────────────────────────────
model Follow {
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  follower     User     @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following    User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ─── Posts ─────────────────────────────────────────────────────
model Post {
  id           String   @id @default(uuid())
  userId       String
  content      String
  postType     String   @default("post")
  mediaUrls    String   @default("[]")
  teamTag      String?
  playerTag    String?
  isBreaking   Boolean  @default(false)
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  shareCount   Int      @default(0)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        PostLike[]
  poll         Poll?

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([postType])
}

// ─── Post Likes ────────────────────────────────────────────────
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// ─── Comments ──────────────────────────────────────────────────
model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ─── Polls ─────────────────────────────────────────────────────
model Poll {
  id         String   @id @default(uuid())
  postId     String   @unique
  question   String
  options    String   @default("[]")
  totalVotes Int      @default(0)
  endsAt     DateTime?
  createdAt  DateTime @default(now())

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ─── Matches ───────────────────────────────────────────────────
model Match {
  id         String   @id @default(uuid())
  league     String
  homeTeam   String
  awayTeam   String
  homeScore  Int?
  awayScore  Int?
  status     String   @default("upcoming")
  minute     Int?
  venue      String?
  kickoffAt  DateTime
  events     String   @default("[]")
  continent  String   @default("Europe")
  country    String   @default("England")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  predictions Prediction[]

  @@index([status])
  @@index([kickoffAt])
  @@index([league])
}

// ─── Predictions ───────────────────────────────────────────────
model Prediction {
  id             String   @id @default(uuid())
  userId         String
  matchId        String?
  homeTeam       String
  awayTeam       String
  predictedHome  Int?
  predictedAway  Int?
  result         String?
  isCorrect      Boolean?
  pointsEarned   Int      @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId],  references: [id], onDelete: Cascade)
  match          Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Communities ───────────────────────────────────────────────
model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  topic       String?
  memberCount Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members     CommunityMember[]
}

model CommunityMember {
  communityId String
  userId      String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId],      references: [id], onDelete: Cascade)

  @@id([communityId, userId])
}

// ─── Notifications ─────────────────────────────────────────────
model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String?
  isRead      Boolean  @default(false)
  actorId     String?
  referenceId String?
  createdAt   DateTime @default(now())

  user        User             @relation("NotificationUser",  fields: [userId],  references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

// ─── Messages ──────────────────────────────────────────────────
model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("MessageSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// ─── Verification Requests ─────────────────────────────────────
model VerificationRequest {
  id          String   @id @default(uuid())
  userId      String
  role        String
  roleData    String   @default("{}")
  status      String   @default("pending")
  adminNotes  String?
  reviewedBy  String?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}
