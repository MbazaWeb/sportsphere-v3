generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           String     @id @default(uuid())
  name         String     @unique
  slug         String     @unique
  description  String
  icon         String     @default("👤")
  category     String     @default("individual")
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  types        RoleType[]
  users        User[]     @relation("UserRole")
}

model RoleType {
  id           String   @id @default(uuid())
  roleId       String
  name         String
  slug         String
  description  String?
  requirements Json     @default("[]")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  users        User[]   @relation("UserRoleType")

  @@unique([roleId, slug])
  @@index([roleId])
}

model Sport {
  id            String         @id @default(uuid())
  name          String         @unique
  slug          String         @unique
  icon          String?
  category      String?
  sportType     String?
  format        String?
  contactType   String?
  olympicStatus String?
  description   String?
  tags          Json           @default("[]")
  isActive      Boolean        @default(true)
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  Coach         Coach[]
  League        League[]
  MatchProfile  MatchProfile[]
  NewsItem      NewsItem[]
  Player        Player[]
  Rumor         Rumor[]
  Team          Team[]
  userSports    UserSport[]
  Business      Business[]
}

model UserSport {
  id        String   @id @default(uuid())
  userId    String
  sportId   String
  createdAt DateTime @default(now())
  sport     Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
  @@index([userId])
  @@index([sportId])
}

model User {
  id                       String                        @id @default(uuid())
  name                     String
  email                    String                        @unique
  handle                   String                        @unique
  passwordHash             String?
  resetToken               String?
  resetTokenExpiry         DateTime?
  avatarUrl                String?
  avatarInitials           String?
  role                     String                        @default("fan")
  verificationStatus       String                        @default("none")
  isVerified               Boolean                       @default(false)
  bio                      String?
  location                 String?
  coverGradient            String                        @default("from-emerald-600 to-emerald-900")
  followerCount            Int                           @default(0)
  followingCount           Int                           @default(0)
  postCount                Int                           @default(0)
  registeredAt             DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  lastSeenAt               DateTime                      @default(now())
  aboutMe                  String?
  city                     String?
  countryOfOrigin          String?
  coverUrl                 String?
  currentCountry           String?
  dateOfBirth              DateTime?
  emailVerified            Boolean                       @default(false)
  emailVerifyExpiry        DateTime?
  emailVerifyToken         String?
  fontSize                 String?                       @default("medium")
  gender                   String?
  highContrast             Boolean                       @default(false)
  interests                Json                          @default("[]")
  isPro                    Boolean                       @default(false)
  nationality              String?
  notifPrefs               Json                          @default("{}")
  phone                    String?
  preferences              Json                          @default("{}")
  preferredLanguage        String?                       @default("en")
  privacySettings          Json                          @default("{}")
  proSince                 DateTime?
  proTier                  String?
  pronouns                 String?
  reducedMotion            Boolean                       @default(false)
  region                   String?
  roleId                   String                        @default("fan-default-role")
  roleProfile              Json                          @default("{}")
  roleTypeId               String                        @default("fan-casual-type")
  socialFacebook           String?
  socialInstagram          String?
  socialLinkedIn           String?
  socialThreads            String?
  socialTikTok             String?
  socialX                  String?
  socialYouTube            String?
  theme                    String?                       @default("dark")
  timezone                 String?
  website                  String?
  whatsapp                 String?
  roleData                 Json                          @default("{}")
  sportsFollowing          Json                          @default("[]")
  isBanned                 Boolean                       @default(false)
  bannedAt                 DateTime?
  bannedReason             String?
  academyProfile           AcademyProfile?
  agentProfile             AgentProfile?
  analystProfile           AnalystProfile?
  businessProfile          BusinessProfile?
  claimedTeams             Team[]                        @relation("TeamClaimedBy")
  claimedPlayers           Player[]                      @relation("PlayerClaimedBy")
  claimedCoaches           Coach[]                       @relation("CoachClaimedBy")
  coachProfile             CoachProfile?
  comments                 Comment[]
  commentLikes             CommentLike[]
  commentatorProfile       CommentatorProfile?
  commercialPartnerProfile CommercialPartnerProfile?
  createdCommunities       Community[]
  communityMemberships     CommunityMember[]
  communityProfile         CommunityProfile?
  competitionProfile       CompetitionProfile?
  creatorProfile           CreatorProfile?
  sentFollows              Follow[]                      @relation("Follower")
  receivedFollows          Follow[]                      @relation("Following")
  journalistProfile        JournalistProfile?
  leaderboardEntries       LeaderboardEntry[]
  leagueProfile            LeagueProfile?
  receivedMessages         Message[]                     @relation("MsgReceiver")
  sentMessages             Message[]                     @relation("MsgSender")
  actorNotifications       Notification[]                @relation("NotifActor")
  notifications            Notification[]                @relation("NotifUser")
  organizationProfile      OrganizationProfile?
  performanceEvents        PerformanceEvent[]
  pointTransactions        PerformancePointTransaction[]
  performanceProfile       PerformanceProfile?
  performanceSnapshots     PerformanceSnapshot[]
  performanceVerifications PerformanceVerification[]
  playerProfile            PlayerProfile?
  posts                    Post[]
  likes                    PostLike[]
  predictions              Prediction[]
  rankingHistory           RankingHistory[]
  scoutProfile             ScoutProfile?
  teamProfile              TeamProfile?
  userRole                 Role                          @relation("UserRole", fields: [roleId], references: [id])
  userRoleType             RoleType                      @relation("UserRoleType", fields: [roleTypeId], references: [id])
  UserAdminRole            UserAdminRole[]
  pushTokens               PushToken[]
  favorites                UserFavorite[]                @relation("UserFavorites")
  userSports               UserSport[]
  venueProfile             VenueProfile?
  verificationReqs         VerificationRequest[]

  @@index([handle])
  @@index([email])
  @@index([role])
  @@index([roleId])
  @@index([resetToken])
  @@index([emailVerifyToken])
  @@index([isBanned])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id           String      @id @default(uuid())
  userId       String
  content      String
  postType     String      @default("post")
  teamTag      String?
  playerTag    String?
  isBreaking   Boolean     @default(false)
  likeCount    Int         @default(0)
  commentCount Int         @default(0)
  shareCount   Int         @default(0)
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  hashtags     Json        @default("[]")
  location     String?
  mediaUrls    Json        @default("[]")
  comments     Comment[]
  poll         Poll?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  prediction   Prediction? @relation("PostPrediction")

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([postType])
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model Comment {
  id               String        @id @default(uuid())
  postId           String
  userId           String
  content          String
  likeCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  parentId         String?
  mentionedUserIds Json          @default("[]")
  parent           Comment?      @relation("CommentReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]     @relation("CommentReply")
  post             Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes            CommentLike[]

  @@index([postId])
  @@index([parentId])
  @@index([userId])
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model Poll {
  id         String     @id @default(uuid())
  postId     String     @unique
  question   String
  totalVotes Int        @default(0)
  endsAt     DateTime?
  createdAt  DateTime   @default(now())
  options    Json       @default("[]")
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes      PollVote[]
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Match {
  id          String       @id @default(uuid())
  league      String
  homeTeam    String
  awayTeam    String
  homeScore   Int?
  awayScore   Int?
  status      String       @default("upcoming")
  minute      Int?
  venue       String?
  kickoffAt   DateTime
  continent   String       @default("Europe")
  country     String       @default("England")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      Json         @default("[]")
  predictions Prediction[]

  @@index([status])
  @@index([kickoffAt])
  @@index([league])
}

model Prediction {
  id            String   @id @default(uuid())
  userId        String
  matchId       String?
  homeTeam      String
  awayTeam      String
  predictedHome Int?
  predictedAway Int?
  result        String?
  isCorrect     Boolean?
  pointsEarned  Int      @default(0)
  createdAt     DateTime @default(now())
  confidence    String?
  postId        String?  @unique
  match         Match?   @relation(fields: [matchId], references: [id])
  post          Post?    @relation("PostPrediction", fields: [postId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Community {
  id          String            @id @default(uuid())
  name        String
  description String?
  topic       String?
  memberCount Int               @default(0)
  createdById String?
  createdAt   DateTime          @default(now())
  createdBy   User?             @relation(fields: [createdById], references: [id])
  members     CommunityMember[]
}

model CommunityMember {
  communityId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String?
  isRead      Boolean  @default(false)
  actorId     String?
  referenceId String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("NotifActor", fields: [actorId], references: [id])
  user        User     @relation("NotifUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("MsgReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

model VerificationRequest {
  id          String    @id @default(uuid())
  userId      String
  role        String
  status      String    @default("pending")
  adminNotes  String?
  reviewedBy  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  roleId      String?
  roleTypeId  String?
  roleData    Json      @default("{}")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([roleId])
}

model LeaderboardEntry {
  id                 String   @id @default(uuid())
  userId             String
  period             String   @default("monthly")
  correctPredictions Int      @default(0)
  totalPredictions   Int      @default(0)
  points             Int      @default(0)
  rank               Int      @default(0)
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

model UserFavorite {
  id           String             @id @default(uuid())
  userId       String
  targetType   FavoriteTargetType
  targetId     String
  targetName   String
  targetHandle String?
  createdAt    DateTime           @default(now())
  user         User               @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType])
  @@index([targetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  module     String
  targetId   String?
  targetType String?
  oldValue   Json?    @default("{}")
  newValue   Json?    @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([module])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model PlayerProfile {
  userId             String    @id
  position           String?
  secondaryPosition  String?
  preferredFoot      String?
  jerseyNumber       String?
  height             Float?
  weight             Float?
  dateOfBirth        DateTime?
  nationality        String?
  playerType         String?
  careerStatus       String?
  appearances        Float?
  starts             Float?
  minutes            Float?
  goals              Float?
  assists            Float?
  yellowCards        Float?
  redCards           Float?
  rating             Float?
  motm               Float?
  passAccuracy       Float?
  chancesCreated     Float?
  shots              Float?
  shotsOnTarget      Float?
  tackles            Float?
  interceptions      Float?
  duelsWon           Float?
  aerialDuels        Float?
  cleanSheets        Float?
  saves              Float?
  savePct            Float?
  goalsConceded      Float?
  penaltiesSaved     Float?
  currentClub        String?
  contractUntil      String?
  contractStatus     String?
  academy            String?
  debutYear          String?
  nationalTeam       String?
  internationalCaps  Float?
  internationalGoals Float?
  transferHistory    String?
  marketValue        String?
  playingStyle       String?
  strengths          String[]
  weaknesses         String[]
  injuryHistory      String?
  form               String?
  ranking            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachProfile {
  userId              String    @id
  coachingRole        String?
  currentTeam         String?
  license             String?
  licenseFederation   String?
  nationality         String?
  dateOfBirth         DateTime?
  yearsCoaching       Float?
  matchesManaged      Float?
  wins                Float?
  draws               Float?
  losses              Float?
  goalsFor            Float?
  goalsAgainst        Float?
  cleanSheets         Float?
  pointsPerGame       Float?
  trophiesWon         Float?
  preferredFormation  String?
  alternateFormations String[]
  playingPhilosophy   String?
  pressingStyle       String?
  possessionStyle     String?
  defensiveApproach   String?
  buildUpStyle        String?
  previousClubs       String?
  nationalTeams       String?
  academyExperience   String?
  playingCareer       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamProfile {
  userId          String   @id
  nickname        String?
  foundedYear     String?
  country         String?
  city            String?
  stadium         String?
  capacity        Float?
  league          String?
  division        String?
  coach           String?
  owner           String?
  colors          String?
  matchesPlayed   Float?
  wins            Float?
  draws           Float?
  losses          Float?
  goalsFor        Float?
  goalsAgainst    Float?
  points          Float?
  position        String?
  form            String?
  squad           String?
  achievements    String?
  historicPlayers String?
  historicCoaches String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScoutProfile {
  userId                String   @id
  scoutType             String?
  organization          String?
  geographicCoverage    String?
  sportsCovered         String[]
  yearsExperience       Float?
  specialization        String?
  playersDiscovered     Float?
  playersRecommended    Float?
  successfulSignings    Float?
  countriesCovered      Float?
  competitionsMonitored Float?
  scoutingBoard         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalistProfile {
  userId           String   @id
  publication      String?
  beat             String?
  location         String?
  yearsActive      Float?
  languages        String[]
  coverage         String[]
  articleCount     Float?
  exclusives       Float?
  interviews       Float?
  breakingNews     Float?
  totalViews       String?
  pressCredentials String?
  articles         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorProfile {
  userId           String   @id
  creatorType      String?
  platforms        String[]
  niche            String?
  audienceLocation String?
  audienceAgeRange String?
  audienceGender   String?
  languages        String[]
  followers        String?
  engagementRate   Float?
  avgViews         String?
  reach            String?
  postsPerWeek     Float?
  topContent       String?
  brandCollabs     String?
  bookingEmail     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalystProfile {
  userId           String   @id
  analystType      String?
  organization     String?
  expertise        String[]
  reportsPublished Float?
  modelsCreated    Float?
  teamsAnalyzed    Float?
  playersAnalyzed  Float?
  topModels        String?
  predictions      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommentatorProfile {
  userId          String   @id
  commentatorType String?
  broadcaster     String?
  languages       String[]
  sports          String[]
  yearsActive     Float?
  matchesCovered  Float?
  competitions    Float?
  countries       Float?
  majorEvents     String?
  matchLog        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  userId             String   @id
  agentType          String?
  agency             String?
  license            String?
  federation         String?
  countries          String[]
  playersRepresented Float?
  coachesRepresented Float?
  transfersCompleted Float?
  totalTransferValue String?
  activeNegotiations Float?
  contractsManaged   Float?
  clientRoster       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OrganizationProfile {
  userId       String   @id
  orgType      String?
  country      String?
  headquarters String?
  foundedYear  String?
  leadership   String?
  departments  String?
  affiliates   String?
  competitions String?
  programs     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompetitionProfile {
  userId          String   @id
  competitionName String?
  season          String?
  organizer       String?
  country         String?
  level           String?
  format          String?
  participants    Float?
  topScorer       String?
  topAssists      String?
  standings       String?
  fixtures        String?
  previousWinners String?
  records         String?
  bracket         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeagueProfile {
  userId                String   @id
  leagueName            String?
  country               String?
  division              String?
  organizer             String?
  foundedYear           String?
  currentSeason         String?
  teams                 Float?
  matchdays             Float?
  topScorer             String?
  topAssists            String?
  avgGoals              Float?
  avgAttendance         Float?
  allTimeTopScorer      String?
  allTimeTopAppearances String?
  standings             String?
  fixtures              String?
  champions             String?
  previousChampions     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademyProfile {
  userId           String   @id
  academyName      String?
  parentOrg        String?
  location         String?
  foundedYear      String?
  director         String?
  programs         String[]
  curriculum       String?
  playersDeveloped Float?
  playersPromoted  Float?
  proGraduates     Float?
  scholarships     Float?
  graduates        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VenueProfile {
  userId         String   @id
  venueName      String?
  venueType      String?
  location       String?
  capacity       Float?
  surface        String?
  opened         String?
  owner          String?
  operator       String?
  facilities     String[]
  tenants        String?
  upcomingEvents String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessProfile {
  userId          String    @id
  companyName     String?
  industry        String?
  foundedYear     String?
  headquarters    String?
  website         String?
  employees       Float?
  products        String?
  partnerTeams    String?
  partnerAthletes String?
  sponsorships    String?
  campaigns       String?
  businessId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Business        Business? @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model CommercialPartnerProfile {
  userId                String   @id
  partnerType           String?
  brand                 String?
  sportsCategory        String?
  partnershipStatus     String?
  foundedYear           String?
  headquarters          String?
  website               String?
  sponsoredTeams        String?
  sponsoredPlayers      String?
  sponsoredCompetitions String?
  sponsoredEvents       String?
  activeCampaigns       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityProfile {
  userId        String   @id
  communityName String?
  communityType String?
  foundedYear   String?
  location      String?
  supportedTeam String?
  description   String?
  memberCount   Float?
  activeMembers Float?
  eventCount    Float?
  postCount     Float?
  events        String?
  rules         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PerformanceProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  performanceScore         Float     @default(0)
