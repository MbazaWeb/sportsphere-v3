model PlayerTransfer {
  id            String    @id @default(cuid())
  playerId      String
  fromTeamId    String?
  toTeamId      String?
  transferType  String    @default("permanent") // permanent | loan | free | loan_return
  fee           String?
  currency      String?   @default("EUR")
  announcedAt   DateTime  @default(now())
  effectiveAt   DateTime  @default(now())
  window        String?   // summer | winter | mid-season | other
  season        String?
  contractUntil DateTime?
  loanUntil     DateTime?
  status        String    @default("completed") // pending | completed | cancelled | active_loan
  notes         String?
  createdById   String?
