  improvementScore         Float     @default(0)
  rankGlobal               Int       @default(0)
  rankCountry              Int       @default(0)
  rankRegion               Int       @default(0)
  rankCategory             Int       @default(0)
  rankPosition             Int       @default(0)
  rankCompetition          Int       @default(0)
  rankForm                 Int       @default(0)
  rankSeason               Int       @default(0)
  rankCareer               Int       @default(0)
  rankImprovement          Int       @default(0)
  rankConsistency          Int       @default(0)
  rankMovement             Int       @default(0)
  categoryBucket           String    @default("")
  position                 String?
