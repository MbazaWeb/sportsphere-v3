  ToTeam        Team?     @relation("TransferToTeam", fields: [toTeamId], references: [id])

  @@index([playerId])
  @@index([fromTeamId])
  @@index([toTeamId])
  @@index([status])
  @@index([announcedAt])
  @@index([transferType])
}

