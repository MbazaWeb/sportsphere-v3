# Sportsphere Mobile — Environment Variables
#
# Copy this file to `.env` and adjust to match your dev setup.
# All Expo public env vars MUST be prefixed with EXPO_PUBLIC_.

# ─── Backend URL ────────────────────────────────────────────────
# The deployed Next.js API. The mobile app sends all requests here.
#
# Production (live VPS — Phase C):
EXPO_PUBLIC_API_URL=http://104.152.50.173:3002/sportsphere

# • Android emulator:  use 10.0.2.2 (alias for host's localhost)
# • iOS simulator:     use localhost
# • Physical device:   use your dev machine's LAN IP (e.g. 192.168.1.50)
#
# Example for local dev against a Next.js app on your machine:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/sportsphere
