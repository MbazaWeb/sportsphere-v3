{
  "name": "sportsphere-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:ios": "expo prebuild --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime":           "~4.0.0",
    "@expo/vector-icons":            "^14.0.2",
    "@expo-google-fonts/inter":      "^0.4.2",
    "@expo-google-fonts/outfit":     "^0.4.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native":      "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sportsphere/api-client":       "file:../packages/api-client",
    "@sportsphere/design-system":    "file:../packages/design-system",
    "@sportsphere/types":            "file:../packages/types",
    "expo":                          "~52.0.0",
    "expo-constants":                "~17.0.3",
    "expo-font":                     "~13.0.1",
    "expo-haptics":                  "~14.0.0",
    "expo-image":                    "~2.0.0",
    "expo-linking":                  "~7.0.3",
    "expo-router":                   "~4.0.9",
    "expo-secure-store":             "~14.0.0",
    "expo-splash-screen":            "~0.29.0",
    "expo-status-bar":               "~2.0.0",
    "expo-symbols":                  "~0.2.0",
    "expo-system-ui":                "~4.0.4",
    "expo-updates":                  "~0.27.0",
    "expo-web-browser":              "~14.0.1",
    "lucide-react-native":           "^0.454.0",
    "nativewind":                    "^4.1.23",
    "react":                         "18.3.1",
    "react-dom":                     "18.3.1",
    "react-native":                  "0.76.5",
    "react-native-gesture-handler":  "~2.20.2",
    "react-native-reanimated":       "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens":          "~4.4.0",
    "react-native-svg":              "15.8.0",
    "react-native-web":              "~0.19.13",
    "zustand":                       "^5.0.1"
