{
  "expo": {
    "name": "Sportsphere",
    "slug": "sportsphere",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sportsphere",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportsphere.app",
      "backgroundColor": "#0A1628",
      "associatedDomains": [
        "applinks:sportssphere.fun"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Sportsphere",
        "CFBundleShortVersionString": "1.0.0",
        "NSCameraUsageDescription": "Sportsphere needs camera access so you can attach photos to posts and updates to your profile.",
        "NSPhotoLibraryUsageDescription": "Sportsphere needs photo library access so you can pick images for posts, highlights, and your profile avatar.",
        "NSPhotoLibraryAddUsageDescription": "Sportsphere can save highlight images you create back to your photo library.",
        "NSMicrophoneUsageDescription": "Sportsphere uses the microphone only when you record short video highlights for posts.",
        "NSLocationWhenInUseUsageDescription": "Sportsphere uses your location to surface nearby matches, venues, and sports communities on the Scores tab.",
        "NSUserTrackingUsageDescription": "Sportsphere uses this to measure campaign performance and improve your feed relevance. No data is shared with third parties.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.sportsphere.app",
      "backgroundColor": "#0A1628",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sportssphere.fun",
              "pathPrefix": "/p"
            },
            {
              "scheme": "https",
              "host": "sportssphere.fun",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/f649f294-ee92-4e7f-a85e-716534fa4adb",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-secure-store",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c2df5186-621b-4b5c-a774-3cc59e7d1ced"
      }
    },
    "owner": "mbazzacodes"
  }
}
