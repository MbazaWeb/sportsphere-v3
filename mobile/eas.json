{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium",
        "withoutCredentials": true,
        "cache": {
          "disabled": false,
          "key": "gradle-v2-no-newarch",
          "paths": [
            "~/.gradle/caches",
            "~/.gradle/wrapper",
            "android/.gradle",
            "android/app/build"
          ]
        }
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun/api"
      },
      "node": "20.18.0"
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun/api"
      },
      "node": "20.18.0"
    }
  }
}
