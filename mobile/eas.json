{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://104.152.50.173:3002/sportsphere"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://104.152.50.173:3002/sportsphere"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "applicationArchivePath": "build/Sportsphere.ipa",
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "applicationArchivePath": "build/Sportsphere.aab",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://104.152.50.173:3002/sportsphere"
      }
    }
  },
  "submit": {
    "development": {
      "ios": {
        "appleId": "your-apple-id@email.com",
        "ascAppId": "your-app-store-connect-app-id",
        "appleTeamId": "your-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "./store/google-service-account-key.json",
        "package": "com.sportsphere.app",
        "track": "internal"
      }
    },
    "preview": {
      "ios": {
        "appleId": "your-apple-id@email.com",
        "ascAppId": "your-app-store-connect-app-id",
        "appleTeamId": "your-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "./store/google-service-account-key.json",
        "package": "com.sportsphere.app",
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleId": "your-apple-id@email.com",
        "ascAppId": "your-app-store-connect-app-id",
        "appleTeamId": "your-apple-team-id",
        "ascApiKeyPath": "./store/AuthKey_<KEY_ID>.p8",
        "ascApiKeyId": "<KEY_ID>",
        "ascApiKeyIssuerId": "<ISSUER_ID>"
      },
      "android": {
        "serviceAccountKeyPath": "./store/google-service-account-key.json",
        "package": "com.sportsphere.app",
        "track": "production"
      }
    }
  },
  "update": {
    "url": "https://u.expo.dev/your-project-id"
  }
}
