{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium",
        "cache": {
          "key": "gradle-v1",
          "paths": [
            "~/.gradle/caches",
            "~/.gradle/wrapper"
          ]
        }
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun/sportsphere"
      }
    },
    "production": {
      "channel": "production"
    }
  }
}