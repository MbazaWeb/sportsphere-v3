{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun",
        "EXPO_PUBLIC_WS_URL": "wss://sportssphere.fun/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true,
        "cache": {
          "key": "v6-full-ui-no-newarch",
          "paths": [
            "~/.gradle/caches",
            "~/.gradle/wrapper"
          ]
        }
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun",
        "EXPO_PUBLIC_WS_URL": "wss://sportssphere.fun/ws"
      },
      "node": "20.18.0"
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sportssphere.fun",
        "EXPO_PUBLIC_WS_URL": "wss://sportssphere.fun/ws"
      },
      "node": "20.18.0"
    }
  }
}
