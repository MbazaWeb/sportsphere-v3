{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@sportsphere/design-system": ["../packages/design-system/src"],
      "@sportsphere/design-system/*": ["../packages/design-system/src/*"],
      "@sportsphere/types": ["../packages/types/src"],
      "@sportsphere/types/*": ["../packages/types/src/*"],
      "@sportsphere/api-client": ["../packages/api-client/src"],
      "@sportsphere/api-client/*": ["../packages/api-client/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../packages/design-system/src/**/*.ts",
    "../packages/types/src/**/*.ts",
    "../packages/api-client/src/**/*.ts"
  ]
}
